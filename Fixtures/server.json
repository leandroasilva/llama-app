      "env": [
        ["GGML_METAL_NO_RESIDENCY", "1"],
        ["LLAMA_CACHE", "/tmp/llama-empty-cache"]
      ],
      "command": "export GGML_METAL_NO_RESIDENCY=1\nexport LLAMA_CACHE=/tmp/llama-empty-cache\n\n/Users/x/llama serve \\\n  --models-preset '/Library/Application Support/Llama/models.ini' \\\n  --log-file /Users/x/Library/Logs/Llama/llama-server.log \\\n  --port 9931 \\\n  --sleep-idle-seconds 300 \\\n  --jinja \\\n  serve  # custom arguments"
    },
