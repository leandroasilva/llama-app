    },
    {
      "name": "wildcard-always-binds",
      "configured": "0.0.0.0",
      "localAddrs": ["192.168.1.5"],
      "expected": "0.0.0.0"
    },
    {
      "name": "stale-address-falls-back",
      "configured": "10.0.0.2",
      "localAddrs": ["192.168.1.5"],
      "expected": null
