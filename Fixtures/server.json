  "pickIpCases": [
    {
      "name": "primary-interface-wins",
      "addresses": [["en0", "192.168.1.5"], ["en1", "192.168.2.9"]],
      "primary": "en1",
      "expected": "192.168.2.9"
    },
    {
      "name": "missing-primary-falls-back-sorted",
      "addresses": [["en0", "192.168.1.5"], ["en1", "192.168.2.9"]],
      "primary": "missing",
      "expected": "192.168.1.5"
    },
    {
      "name": "no-primary-sorted",
      "addresses": [["en0", "192.168.1.5"], ["en1", "192.168.2.9"]],
      "primary": null,
      "expected": "192.168.1.5"
    },
    {
      "name": "no-addresses",
      "addresses": [],
      "primary": null,
      "expected": null
    }
  ],
  "tailscaleAddressCases": [
    {
      "name": "picks-smallest-utun-cgnat",
      "addresses": [
        ["en0", "192.168.1.5"],
        ["utun4", "100.64.0.9"],
        ["utun5", "100.64.0.3"],
        ["utun6", "10.0.0.1"]
      ],
      "expected": "100.64.0.3"
    },
    {
      "name": "none-qualifies",
      "addresses": [["en0", "192.168.1.5"], ["utun6", "10.0.0.1"]],
      "expected": null
    }
  ],
  "effectiveBindCases": [
    {
      "name": "held-address-passes",
